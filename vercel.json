{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/remind-instructors",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/instructor-eval-report",
      "schedule": "0 12 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/instructor.html",
      "has": [
        {
          "type": "host",
          "value": "register.mindfulbeginnings.org"
        }
      ],
      "destination": "https://instructorportal.mindfulbeginnings.org/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mindfulbeginnings.vercel.app"
        }
      ],
      "destination": "https://register.mindfulbeginnings.org/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "mindfulbeginnings.vercel.app"
        }
      ],
      "destination": "https://register.mindfulbeginnings.org/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/register.html",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "register.mindfulbeginnings.org"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/configinstructor.js",
      "destination": "/config-instructor.js"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "instructorportal.mindfulbeginnings.org"
        }
      ],
      "destination": "/instructor.html"
    },
    {
      "source": "/cpr-certification",
      "destination": "/cpr-certification.html"
    },
    {
      "source": "/cpr-certification/",
      "destination": "/cpr-certification.html"
    },
    {
      "source": "/classes-catalog",
      "destination": "/classes-catalog.html"
    },
    {
      "source": "/classes-catalog/",
      "destination": "/classes-catalog.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/admin-build.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/public-sessions.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/payments.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/confirmation-email.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/class-requests.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/class-requests-admin.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/class-request-form.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/intake.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/config-instructor.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
