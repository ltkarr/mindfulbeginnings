{
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "mindfulbeginnings.vercel.app" }
      ],
      "destination": "https://register.mindfulbeginnings.org/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        { "type": "host", "value": "mindfulbeginnings.vercel.app" }
      ],
      "destination": "https://register.mindfulbeginnings.org/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/register.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/our-team",
      "destination": "/our-team.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/js/public-sessions.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
