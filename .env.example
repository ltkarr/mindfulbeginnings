# Copy these into Vercel → Settings → Environment Variables.
# Do not commit real secrets.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
PAYPAL_WEBHOOK_ID=

SUPABASE_URL=https://evninlytzhtacanrguhx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Class-request confirmation drafts in Lindsay's Outlook mailbox.
# Without these, the draft text is stored on the request for copy-paste in ADMIN.
# The app registration needs admin-consented Graph application permissions:
#   Mail.ReadWrite  — create the unsent confirmation draft
#   Mail.Send       — notify lindsay@ only (never the family)
# Confirmation emails are never sent automatically.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_MAILBOX=lindsay@mindfulbeginnings.org

# Optional fallback that notifies lindsay@ when Graph is not configured.
# Template To field must be {{to_email}}. Body variables: {{subject}} and {{message}}.
# This is not the family confirmation.
EMAILJS_TEMPLATE_CLASS_REQUEST=
EMAILJS_PRIVATE_KEY=
